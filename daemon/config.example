# ToknMon daemon config
#
# Copy this file to:
#   macOS         : ~/.config/toknmon/config
#                   (the daemon copies ~/.config/claude-usage-monitor/config here
#                    on first start if it exists and this file does not)
#   Linux         : ~/.config/claude-usage-monitor/config (inherited Clawdmeter daemon)
#   Windows       : %LOCALAPPDATA%\Clawdmeter\config    (inherited Clawdmeter daemon)
#
# The daemon re-reads it on every poll, so edits take effect within ~60s — no restart needed.

# Bluetooth name of your board, as set when flashing (flash-mac.sh prompts for
# it; or type `name <text>` into the board's USB serial console). Max 18 ASCII
# characters. The daemon finds the device by its service UUID regardless of
# name; this only matters for the HID fallback and stale-bond repair, where
# the legacy names "TokenMon" and "Clawdmeter" are always accepted too.
#   Unset (default) = ToknMon
# device_name = ToknMon

# Poll more than one Claude config dir and show whichever plan is currently
# active. Use this if you run separate plans from different config dirs (e.g. a
# personal plan in ~/.claude and a work plan in ~/.claude-work, selected via
# CLAUDE_CONFIG_DIR). Comma-separated; ~ is expanded.
#   - The daemon polls every listed dir each cycle and displays the plan whose
#     usage rose most recently (i.e. the one you're actively using). Before any
#     change is seen it shows the plan with the highest current usage.
#   - Unset (default) = just ~/.claude, unchanged single-plan behavior.
#   - install.sh can detect your ~/.claude* dirs and fill this in for you.
# config_dirs = ~/.claude, ~/.claude-work

# Providers to monitor (macOS daemon). The device keeps one usage slot per
# provider and cycles through them (tap to advance).
#   auto (default) = poll every provider whose CLI is installed and logged in on
#            this Mac, re-checked on every poll: install or log in to a CLI
#            later and it appears on the device within a minute, no reinstall
#            and no restart. The daemon logs the resolved set whenever it
#            changes ("Providers (auto): claude, codex — kimi skipped: ...").
#            Detection is local, never touches the network, and looks for:
#              claude = an OAuth token in the macOS Keychain ("Claude Code-
#                       credentials") or in <config_dir>/.credentials.json for
#                       any dir in config_dirs
#              codex  = at least one rollout-*.jsonl under
#                       ${CODEX_HOME:-~/.codex}/sessions (any age)
#              kimi   = a credential file with an access token under
#                       ~/.kimi-code/credentials (an expired token is fine)
#              grok   = an entry with a "key" in ${GROK_HOME:-~/.grok}/auth.json
#                       (an expired token is fine)
#            When only Claude is detected the payload is identical to older
#            daemons (no provider tag); when nothing is detected the device
#            stays on the splash screen.
#   explicit list = comma-separated, any order; polled exactly as written even
#            when a provider is not detected (it then shows "no data"):
#   claude = Claude Code (OAuth usage endpoint; shows 5h, weekly and, when the
#            subscription exposes it, the model-scoped weekly window)
#   codex  = OpenAI Codex CLI (reads ${CODEX_HOME:-~/.codex}/sessions logs; no
#            network, needs a Codex session in the last 7 days)
#   kimi   = Kimi Code (uses the token in ~/.kimi-code/credentials and refreshes
#            it when expired, exactly like the Kimi CLI; override the API with
#            KIMI_CODE_BASE_URL)
#   grok   = Grok Build CLI (weekly credit usage from the CLI's billing
#            endpoint with the key in ${GROK_HOME:-~/.grok}/auth.json, refreshed
#            with Grok's own OIDC protocol under its auth.json.lock when it
#            expires; when the endpoint fails, the last value the grok CLI
#            logged in logs/unified.jsonl is used if it is newer than 6 h.
#            Weekly only, there is no 5-hour window; override the API with
#            GROK_CLI_CHAT_PROXY_BASE_URL, https:// only)
# providers = auto
# providers = claude, codex, kimi, grok

# Kimi OAuth token endpoint used to refresh an expired Kimi access token (HTTPS
# only). Default: ${KIMI_CODE_OAUTH_HOST:-https://auth.kimi.com}/api/oauth/token.
# kimi_token_url = https://auth.kimi.com/api/oauth/token

# Grok OIDC token endpoint used to refresh an expired Grok access token (HTTPS
# only). Default: the token_endpoint discovered from the oidc_issuer in
# ${GROK_HOME:-~/.grok}/auth.json (currently https://auth.x.ai/oauth2/token).
# grok_token_url = https://auth.x.ai/oauth2/token

# Seconds between Anthropic API polls (Linux daemon). Default 60. Minimum 10.
# The firmware marks data older than 90s as stale and only updates its "resets
# in" countdown when a payload lands, so anything above ~80 relies on the
# heartbeat below to keep the display live.
# poll_interval = 60

# Seconds between heartbeat replays of the last payload while waiting for the
# next API poll (Linux daemon). The replay ages the reset countdowns and clock
# so the display stays accurate without an API call. Default 60. Minimum 10.
# Set it >= poll_interval to disable.
# heartbeat_interval = 60

# Play a sound on the device when your 5-hour session limit resets, so you know
# you can use Claude again without watching the screen.
#   off = silent (default)
#   on  = chime through the board speaker (boards with audio: S3 AMOLED-2.16 / 1.8, LCD-1.54)
chime = off

# Beep when a Claude Code session needs your attention (needs the hooks from the
# README). The mascot walks on and the message shows either way; this only adds
# the sound.
#   off = silent (default)
#   on  = chime through the board speaker (boards with audio: S3 AMOLED-2.16 / 1.8, LCD-1.54)
beep = off
# Show a clock on the Usage screen, in place of the "Usage" title.
#   off  = no clock; the screen keeps showing "Usage" (default)
#   auto = show the clock, auto-detecting 12h/24h from this machine's settings
#          (detection can default to 24h when the daemon runs under launchd/systemd
#           with no locale — set 12 or 24 explicitly below if auto guesses wrong)
#   12   = show the clock, forced 12-hour  (e.g. 6:28 PM)
#   24   = show the clock, forced 24-hour  (e.g. 18:28)
clock = off
