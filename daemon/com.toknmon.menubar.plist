<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.toknmon.menubar</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Applications/ToknMon.app/Contents/MacOS/ToknMon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart only after a crash; "Quit" from the menu (exit 0) stays quit. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/toknmon-menubar.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/toknmon-menubar.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
