# see gallery.jsonl). Capture with SIM_SLOT=1 (Codex): the states play in order, 6 s each, or
# jump with 1-9. Headless: SIM_SCENARIO=sim/credits.jsonl SIM_SLOT=1 SIM_AUTOSHOT_MS=<ms>.
{"name":"claude (alert opens usage)","hold_ms":0,"p":"claude","s":17.0,"sr":110,"w":73.0,"wr":860,"st":"allowed","acct":"pro","ok":true,"t":1785474000,"tf":24,"m":"credits"}
